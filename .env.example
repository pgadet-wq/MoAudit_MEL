# MoAudit MEL - Environment Configuration
# ========================================
# Copy this file to .env and fill in your values

# ===========================================
# API Keys
# ===========================================

# Mistral AI API Key (for LLM features)
MISTRAL_API_KEY=your_mistral_api_key_here

# Hugging Face Token (for model downloads)
HF_TOKEN=your_huggingface_token_here

# ===========================================
# Service URLs (Docker internal)
# ===========================================

# Docling Service URL
DOCLING_SERVICE_URL=http://docling-service:8001

# Granite-Docling VLM Service URL
GRANITE_DOCLING_URL=http://granite-docling:8000/v1

# Parsing Backend: remote_docling, local_docling, fallback
PARSING_BACKEND=remote_docling

# ===========================================
# Redis Configuration
# ===========================================

REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true

# ===========================================
# Storage Configuration
# ===========================================

# Backend: local, s3, scaleway
STORAGE_BACKEND=local

# Scaleway Object Storage (if using s3/scaleway backend)
S3_ENDPOINT_URL=https://s3.fr-par.scw.cloud
S3_ACCESS_KEY=your_scaleway_access_key
S3_SECRET_KEY=your_scaleway_secret_key
S3_BUCKET_NAME=moaudit-documents
S3_REGION=fr-par

# ===========================================
# Database Configuration (Production)
# ===========================================

PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=moaudit
PG_USER=moaudit
PG_PASSWORD=your_secure_password_here

# ===========================================
# Application Settings
# ===========================================

# Debug mode (set to false in production)
DEBUG=false

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ===========================================
# Docling Service Settings
# ===========================================

DOCLING_USE_VLM=true
DOCLING_ENABLE_OCR=true
DOCLING_ENABLE_TABLE_STRUCTURE=true
DOCLING_MAX_FILE_SIZE_MB=100
DOCLING_DOCUMENT_TIMEOUT=300

# ===========================================
# Granite-Docling Settings
# ===========================================

# Model name
GRANITE_MODEL_NAME=ibm-granite/granite-docling-258M

# vLLM settings (GPU mode)
GPU_MEMORY_UTILIZATION=0.85
MAX_MODEL_LEN=8192

# For T4 GPUs (no bfloat16)
# DTYPE=float16
