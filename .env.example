# ===========================================
# MoAudit MEL - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
#
# For production deployment on Scaleway, see:
#   docs/SCALEWAY_DEPLOYMENT.md

# ===========================================
# API Keys
# ===========================================

# Mistral AI API Key (optional - for LLM features)
MISTRAL_API_KEY=your_mistral_api_key_here

# Hugging Face Token (for model downloads)
HF_TOKEN=your_huggingface_token_here

# ===========================================
# Authentication (REQUIRED in production)
# ===========================================

# JWT Secret Key (generate with: openssl rand -base64 32)
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API Key for service-to-service auth (generate with: openssl rand -hex 24)
MOAUDIT_API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_24

# ===========================================
# Service URLs
# ===========================================

# Docling Service URL (internal Docker network)
DOCLING_SERVICE_URL=http://docling-service:8001
DOCLING_TIMEOUT=300

# Granite-Docling VLM Service URL
# For production: use the GPU instance IP
# GRANITE_SERVICE_URL=http://YOUR_GPU_IP:8000/v1
GRANITE_SERVICE_URL=http://granite-docling:8000/v1
GRANITE_MODEL_NAME=ibm-granite/granite-docling-258M

# Parsing Backend: remote_docling, local_docling, fallback
PARSING_BACKEND=remote_docling

# ===========================================
# Redis Configuration
# ===========================================

REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0

# ===========================================
# Storage Configuration
# ===========================================

# Backend: local, s3, scaleway
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/storage

# Scaleway Object Storage (if using s3/scaleway backend)
S3_ENDPOINT_URL=https://s3.fr-par.scw.cloud
S3_ACCESS_KEY=your_scaleway_access_key
S3_SECRET_KEY=your_scaleway_secret_key
S3_BUCKET_NAME=moaudit-documents
S3_REGION=fr-par

# ===========================================
# Database Configuration
# ===========================================

# Mode: sqlite, postgres
DATABASE_MODE=sqlite
SQLITE_PATH=./data/moaudit.db

# PostgreSQL (for production)
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=moaudit
PG_USER=moaudit
PG_PASSWORD=your_secure_password_here

# ===========================================
# Application Settings
# ===========================================

# Debug mode (set to false in production)
DEBUG=false
LOG_LEVEL=INFO

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ===========================================
# Docling Service Settings
# ===========================================

USE_VLM=true
VLM_BACKEND=granite_docling_vllm
ENABLE_OCR=true
ENABLE_TABLE_STRUCTURE=true
MAX_FILE_SIZE_MB=100
DOCUMENT_TIMEOUT=300

# Rate limiting
MAX_CONCURRENT_REQUESTS=5
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_PERIOD=60

# ===========================================
# Granite-Docling VLM Settings (GPU)
# ===========================================

# vLLM settings
GPU_MEMORY_UTILIZATION=0.85
MAX_MODEL_LEN=4096

# For T4 GPUs (no bfloat16 support)
# DTYPE=float16

# For L4/A100 GPUs (bfloat16 supported)
# DTYPE=bfloat16

# ===========================================
# Celery Settings (Async Tasks)
# ===========================================

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540

# ===========================================
# Monitoring (Optional)
# ===========================================

# Slack notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Sentry error tracking
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
