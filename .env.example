# MoAudit_MEL - Environment Variables
# =====================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# === Required ===

# Mistral AI API Key (for LLM-based parsing)
# Get yours at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# === Optional ===

# Server port (default: 8080)
PORT=8080

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Mistral model to use (default: mistral-large-latest)
MISTRAL_MODEL=mistral-large-latest

# === Database (for production) ===
# Uncomment and configure if using PostgreSQL

# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=moaudit
# PG_USER=moaudit
# PG_PASSWORD=secure_password

# === Scaleway Specific ===
# These are set automatically when deploying to Scaleway

# SCW_ACCESS_KEY=your_scaleway_access_key
# SCW_SECRET_KEY=your_scaleway_secret_key
# SCW_DEFAULT_REGION=fr-par
# SCW_DEFAULT_ZONE=fr-par-1
