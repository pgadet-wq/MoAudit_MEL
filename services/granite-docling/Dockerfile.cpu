# Granite-Docling CPU Mode (Transformers)
# =======================================
# For development or environments without GPU

FROM python:3.11-slim-bookworm

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip install --no-cache-dir \
    torch \
    transformers \
    accelerate \
    fastapi \
    uvicorn \
    pillow \
    httpx

# Copy server code
COPY cpu_server.py /app/server.py

# Environment variables
ENV PYTHONUNBUFFERED=1 \
    MODEL_NAME=ibm-granite/granite-docling-258M \
    PORT=8000

# Pre-download model (optional, comment out to download at runtime)
# RUN python -c "from transformers import AutoModelForVision2Seq, AutoProcessor; \
#     AutoProcessor.from_pretrained('${MODEL_NAME}'); \
#     AutoModelForVision2Seq.from_pretrained('${MODEL_NAME}')"

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=180s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Start server
CMD ["python", "server.py"]
